@model HospitalMgmt.Core.Entities.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<h2>Doctor Details</h2>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>

    <dt class="col-sm-3">Specialization</dt>
    <dd class="col-sm-9">@Model.Specialization</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department.Name</dd>

    <dt class="col-sm-3">Consultation Fee</dt>
    <dd class="col-sm-9">@Model.ConsultationFee.ToString("N2")</dd>

    <dt class="col-sm-3">Date of Joining</dt>
    <dd class="col-sm-9">@Model.DateOfJoining.ToString("dd MMM yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>